		{"id":"c390f89c9a8802a5","x":-520,"y":-760,"width":820,"height":1020,"type":"text","text":"Pipeline.cs\nnamespace EDGetDataTest\npublic enum ParameterType { Pending, Text, Integer, Float, Boolean, Array, Link, Date }\n\npublic class PipelineParameter\npublic string Identifier\npublic ParameterType Type\npublic string Value\npublic PipelineParameter(string identifier, ParameterType type, string value = \"\")\n\nabstract class Pipeline\npublic string Identifier\npublic ParameterType Type\npublic PipelineStatus Status\npublic List<PipelineParameter> parameters\npublic abstract bool CreateInsideDatabase(string parentElementReference)\npublic abstract bool UpdateInsideDatabase()\npublic abstract void AddParameters(List<string> parameterIdentifiers)\npublic abstract void AddParameters(List<PipelineParameter> parameters)\npublic abstract void UploadParameterValues()\npublic Pipeline(string pipelineIdentifier)\npublic Pipeline(string pipelineIdentifier, List<PipelineParameter> pipelineParameters)\n\nPipelineED.cs\nnamespace EDGetDataTest\npublic static class EDPipelineParameterExtension\npublic static string ToSqlValueFormat(this PipelineParameter parameter)\n\nclass PipelineED : Pipeline\npublic override void AddParameters(List<string> parameterIdentifiers)\npublic override void AddParameters(List<PipelineParameter> parameters)\npublic override bool CreateInsideDatabase(string paretProjectIdentifier)\npublic override bool UpdateInsideDatabase()\npublic override void UploadParameterValues()\npublic PipelineED(string indentifier)"},
		{"id":"82e3a4900f203691","x":360,"y":-945,"width":1244,"height":1025,"type":"text","text":"Project.cs\nnamespace EDGetDataTest\ninternal abstract class Scope\npublic string Name\npublic string Identifier\npublic List<Pipeline> Pipelines\npublic abstract bool AddPipeline(string identifier)\npublic abstract void AddParameters(List<string> parameterIdentifiers)\npublic abstract bool AddPipeline(string identifier, List<PipelineParameter> parameters)\npublic abstract void CollectPipelines()\npublic abstract bool UploadPipelines()\n\ninternal abstract class Project<TScope>\npublic string Name\npublic string Identifier\npublic List<TScope> Scopes\npublic abstract void AddParameters(List<string> parameterIdentifiers)\npublic abstract void CollectScopes()\npublic abstract void CollectPipelines()\n\nProjectED.cs\nnamespace EDGetDataTest\ninternal class ProjectED : Project<ProjectED.ScopeED>\npublic string TemplatePipelineName\npublic ProjectED(string Identifier)\npublic override void AddParameters(List<string> parameterIdentifiers)\npublic List<string> ExtractTemplateParameters()\npublic override void CollectScopes()\npublic override void CollectPipelines()\n\ninternal class ScopeED : Scope\npublic ScopeED(string name, string id)\npublic override void AddParameters(List<string> parameterIdentifiers)\npublic override bool AddPipeline(string identifier)\npublic override bool AddPipeline(string identifier, List<PipelineParameter> parameters)\npublic override void CollectPipelines()\npublic override bool UploadPipelines()\npublic string CheckTemplatePipelineStatus()"},
		{"id":"e587352466f685ef","x":1680,"y":-945,"width":893,"height":808,"type":"text","text":"Integration.cs\nnamespace EDGetDataTest\ninternal static class Integration\npublic static List<ScopeED> CollectScopesByEnProjectName(string enProjectName)\npublic static List<string> LoadAllEdProjectIdentifiers()\npublic static List<ParametersRalation> LoadMappingTable()\npublic static List<PipelinesRelation> LoadPipelineRelations(List<Scope> projectScopes)\npublic static void MatchAttributeTypes()\npublic static List<PipelinesRelation> Compare(List<PipelinesRelation> pipelines)\n\npublic enum PipelineStatus { Actual, Deprecated, Unexist, Pending, Error }\npublic enum IntegrationError { Null, Unknown, NetworkError, AuthFailed, Timeout }\n\npublic static class ErrorNotifier\nprivate static readonly Dictionary<IntegrationError, string> Messages\npublic static void Spawn(IntegrationError code)\n\npublic class PipelinesRelation\npublic string ReferenceED\npublic string ReferenceEN\npublic IntegrationError IntegrationError\npublic PipelineStatus IntegrationStatus\npublic PipelinesRelation(string referenceEN, string referenceED)\npublic class ParametersRalation  \npublic string ReferenceEN  \npublic string ReferenceED  \npublic ParametersRalation(string referenceEN, string referenceED)"},
