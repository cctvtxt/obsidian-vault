		{"id":"307dec363455ffa1","type":"text","text":"Deployment","x":-162,"y":-308,"width":250,"height":60},
		{"id":"9f8e22e7e8c9196f","type":"text","text":"Delivery Strategies","x":280,"y":-308,"width":280,"height":60},
		{"id":"0c75d9933b921094","type":"text","text":"**Recreate** -  полное пересоздание подов","x":780,"y":-631,"width":450,"height":60},
		{"id":"afeec0e4557e91f6","type":"text","text":"**Rolling Update** - постепенное поднятие новых подов, на которые сразу же подаётся трафик","x":780,"y":-491,"width":620,"height":71},
		{"id":"02fe3748c173bd7f","type":"text","text":"**Blue-Green** -  развёртывание двух версий до подтверждения работоспособности релиза","x":780,"y":-338,"width":680,"height":81},
		{"id":"8e50797b56c9c259","type":"text","text":"**Ring-based** - бета-тесты, региональные или внутренние тестирования","x":780,"y":-169,"width":580,"height":70},
