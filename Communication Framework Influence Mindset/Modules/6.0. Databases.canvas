		{"id":"87b2df8432dfc826","type":"text","text":"Строки","x":4468,"y":3440,"width":250,"height":60},
		{"id":"46d11c17ece561e2","type":"text","text":"TIMESTAMP","x":5202,"y":3675,"width":250,"height":60,"color":"3"},
		{"id":"aa6f9b11c7044f65","type":"text","text":"TIME","x":4971,"y":3757,"width":250,"height":60,"color":"3"},
		{"id":"a05b282d577705a6","type":"text","text":"TIME WITH TIME ZONE","x":5502,"y":3644,"width":303,"height":60,"color":"3"},
		{"id":"6a17e69964e83f5c","type":"text","text":"INTERVAL","x":5367,"y":3787,"width":250,"height":60,"color":"3"},
		{"id":"c190517d6c9d62b7","type":"text","text":"Логика","x":4592,"y":4028,"width":250,"height":60},
		{"id":"2fce1c4ce8cf1f46","type":"text","text":"BOOLEAN","x":4986,"y":4034,"width":250,"height":60,"color":"3"},
