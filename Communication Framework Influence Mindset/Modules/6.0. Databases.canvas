		{"id":"9fb1c47a801b5a69","type":"text","text":"PREPARE TRANSACTION 'tx_1'","x":3854,"y":-412,"width":345,"height":60,"color":"3"},
		{"id":"6d33a3ef4a6eeb3f","type":"text","text":"COMMIT PREPARED 'tx_1';","x":3877,"y":-322,"width":341,"height":58,"color":"3"},
		{"id":"2b11e958b7070272","type":"text","text":"ROLLBACK PREPARED 'tx_1';","x":3854,"y":-235,"width":341,"height":60,"color":"3"},
		{"id":"755e1444a8df0974","type":"text","text":"1. **Dirty Read**","x":4396,"y":-151,"width":250,"height":60},
		{"id":"9997336aac888b4a","type":"text","text":"чтение незакоммиченных данных","x":4276,"y":48,"width":397,"height":60},
		{"id":"5d514084eed551ad","type":"text","text":"PRIMARY KEY","x":3953,"y":-2395,"width":250,"height":60,"color":"3"},
