		{"id":"569686e0457a318d","type":"text","text":"M:M","x":4343,"y":-1909,"width":250,"height":60},
		{"id":"5991c5d9e1beb132","type":"text","text":"CASCADE","x":4622,"y":-2495,"width":250,"height":60,"color":"3"},
		{"id":"8b8cacc5b7a7af4e","type":"text","text":"SER NULL","x":4622,"y":-2395,"width":250,"height":60,"color":"3"},
		{"id":"4607621d30a6c8c3","type":"text","text":"SET DEFAULT","x":4622,"y":-2295,"width":250,"height":60,"color":"3"},
		{"id":"b1519cfbd5efe7ca","type":"text","text":"RESTRICT","x":4622,"y":-2195,"width":250,"height":60,"color":"3"},
		{"id":"455045fd9b340f95","type":"text","text":"NO ACTION","x":4622,"y":-2098,"width":250,"height":60,"color":"3"},
		{"id":"21c37e354dea2893","type":"text","text":"Transactions","x":3090,"y":-635,"width":250,"height":60},
		{"id":"0ab0e3f2d6491f89","type":"text","text":"**Транзакция** — это группа операций, которая работает как одно целое. **пока все команды не будут завершены и пока не выполнится команда COMMIT, в таблицу не попадут изменения**","x":2880,"y":-540,"width":768,"height":105,"color":"#525252"},
		{"id":"368aec5bed03a303","type":"text","text":"Prepared Transactions","x":3090,"y":-395,"width":348,"height":60},
		{"id":"cfdfafd6b9df4013","type":"text","text":"Сервис A публикует транзакцию с именем и выполняет ее (данные сохраняются) с PREPARE, но они **невидимы до коммита**, сервис Б лидо продолжает транзакцию либо сбрасывает, только после его коммита данные становятся видны","x":3090,"y":-293,"width":593,"height":174,"color":"#4f4f4f"},
		{"id":"bea0e64877b6d981","type":"text","text":"TCL","x":2070,"y":-365,"width":250,"height":60,"color":"#0400ff"},
